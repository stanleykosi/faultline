# Configure values privately in the selected Vercel project. Never commit filled values.
# All values below are placeholders. No VITE_ variable may contain a secret.
NODE_ENV=production
FAULTLINE_HOSTING_PROFILE=vercel-supabase
APP_ORIGIN=https://faultline.example
AUTH_SECRET=REPLACE_WITH_EXISTING_OR_NEW_RANDOM_32_PLUS_CHARACTER_SECRET
PUBLIC_SIGNUP_ENABLED=true
AUTH_DATABASE_SCHEMA=faultline_identity

# Separate restricted database roles. Use TLS verification; never the postgres owner for runtime.
# Session-mode pooler or direct URL is required until transaction-pooler behavior is accepted.
DATABASE_URL=postgresql://faultline_api.PROJECT:PASSWORD@POOLER:5432/postgres?sslmode=verify-full
AUTH_DATABASE_URL=postgresql://faultline_auth.PROJECT:PASSWORD@POOLER:5432/postgres?sslmode=verify-full
QUEUE_DATABASE_URL=postgresql://faultline_queue.PROJECT:PASSWORD@POOLER:5432/postgres?sslmode=verify-full
DISPATCHER_DATABASE_URL=postgresql://faultline_dispatcher.PROJECT:PASSWORD@POOLER:5432/postgres?sslmode=verify-full

OBJECT_STORE=supabase
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_STORAGE_BUCKET=faultline-private
SUPABASE_UPLOAD_BUCKET=faultline-uploads
SUPABASE_STORAGE_SERVICE_KEY=SERVER_ONLY_SERVICE_KEY
MODEL_PROVIDER=none
MODEL_ALLOWED_ORIGINS=["https://openrouter.ai"]
# Optional hosted model: set key and model server-side, then redeploy.
# Optionally restrict it using the workspace UUID from /w/<UUID>/.
# OPENROUTER_API_KEY=PRIVATE_OPENROUTER_KEY
# OPENROUTER_MODEL=provider/model-id
# Optional: blank/unset shares the hosted model across workspaces.
# OPENROUTER_WORKSPACE_ID=
RUNNER_MODE=disabled
ALLOW_FIXTURE_ADAPTERS=false
DOMAIN_POOL_MAX=1
AUTH_POOL_MAX=1

# Existing encrypted credential/report keys must be preserved across API and worker.
# Loaded into private ephemeral runtime files; never regenerate on cold start.
FAULTLINE_SEALED_SECRET_KEYRING_JSON_B64=BASE64_EXISTING_KEYRING
FAULTLINE_SEALED_REPORT_SIGNING_PRIVATE_PEM_B64=BASE64_EXISTING_ED25519_PRIVATE_PEM
FAULTLINE_SEALED_REPORT_SIGNING_PUBLIC_PEM_B64=BASE64_EXISTING_ED25519_PUBLIC_PEM
