# Copy privately to .env.local; fill independent runtime role URLs. Never use operator credentials here.
APP_ORIGIN=http://localhost:3000
PORT=3000
DATABASE_URL=postgresql://faultline_api:REPLACE_RANDOM_PASSWORD@127.0.0.1:5432/faultline
AUTH_DATABASE_URL=postgresql://faultline_auth:REPLACE_RANDOM_PASSWORD@127.0.0.1:5432/faultline
QUEUE_DATABASE_URL=postgresql://faultline_queue:REPLACE_RANDOM_PASSWORD@127.0.0.1:5432/faultline
DISPATCHER_DATABASE_URL=postgresql://faultline_dispatcher:REPLACE_RANDOM_PASSWORD@127.0.0.1:5432/faultline
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
OBJECT_STORE=filesystem
OBJECT_STORE_PATH=.runtime/objects
SECRET_KEYRING_PATH=.runtime/keys/keyring.json
REPORT_SIGNING_KEY_PATH=.runtime/keys/report-private.pem
MODEL_PROVIDER=none
RUNNER_MODE=disabled
ALLOW_FIXTURE_ADAPTERS=false
# API listens on loopback; configure a reviewed TLS reverse proxy for a future production origin.

# Physical cleanup is operator-paused until reviewed capability installation/acceptance.
RETENTION_PHYSICAL_PURGE_ENABLED=false
# Owner-created profiles additionally require exact operator origin allowlists. No auto-probe.
CONNECTOR_ALLOWED_ORIGINS=["https://api.github.com","https://us.posthog.com","https://eu.posthog.com"]
POSTHOG_STORAGE_ORIGINS=[]
MODEL_ALLOWED_ORIGINS=[]
MODEL_LOCAL_ORIGINS=[]
# Native supplied-fixture validation only, forbidden by production profile:
# RUNNER_FIXTURE_URL=http://127.0.0.1:3040
# RUNNER_AUTH_KEY_PATH=.runtime/keys/fixture-runner.key
# RUNNER_STATE_ROOT=.runtime/fixture-runner
# RUNNER_ARTIFACT_ROOT=.runtime/fixture-runner/artifacts

# OpenRouter and Meterless Nightshift are independently selectable model profiles.
# Set these values privately, or add an encrypted workspace model profile in the UI.
# OPENROUTER_API_KEY=REPLACE_WITH_PRIVATE_OPENROUTER_KEY
# OPENROUTER_MODEL=REPLACE_WITH_EXACT_MODEL_ID
# OPENROUTER_WORKSPACE_ID=REPLACE_WITH_WORKSPACE_UUID
# METERLESS_RUNTIME_TOKEN=REPLACE_WITH_REAL_NIGHTSHIFT_PROXY_TOKEN
# METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# METERLESS_MODEL=meterless/auto
# METERLESS_WORKSPACE_ID=REPLACE_WITH_WORKSPACE_UUID
# Explicit local Nightshift opt-in: MODEL_LOCAL_ORIGINS=["http://127.0.0.1:8088"]
# Hosted services need an approved reachable HTTPS Nightshift origin in MODEL_ALLOWED_ORIGINS.
# Never expose the upstream NVIDIA key to Faultline; configure it in Nightshift.

# Production Zetaris HTTP adapter bindings contain no credentials. API and worker use the same list.
# Add the exact HTTPS instance origin to CONNECTOR_ALLOWED_ORIGINS first.
# Source credentials are entered privately through the workspace source connection.
ZETARIS_REST_ADAPTERS=[]
# Example binding fields: adapter_id, approved_origin, contract_hash, organisation_id.
# Account scope for this adapter is zetaris:org:<explicit numeric organisation ID>.
