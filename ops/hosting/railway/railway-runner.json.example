{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "ops/images/Runner.Dockerfile"
  },
  "deploy": {
    "startCommand": "node --max-old-space-size=128 dist/server/apps/runner/src/external-main.js",
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
