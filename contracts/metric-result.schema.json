        {
          "type": "null"
        }
      ]
    },
    "relative_change": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -1
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  },
  "required": [
    "metric_hash",
    "quality",
    "basis",
    "baseline",
    "comparison",
    "delta_pp",
    "relative_change"
  ]
