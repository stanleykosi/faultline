# Hardened external runner controller. Empty secrets are intentional.
# Store filled values in the deployment secret manager, never in source control.
NODE_ENV=production
PORT=3000

# Application <-> controller authentication.
EXTERNAL_RUNNER_AUTH_KEY_B64=

# Durable controller state on a persistent private volume.
RUNNER_NONCE_STORE_PATH=/var/lib/faultline-runner/nonces
RUNNER_EXECUTION_LEDGER_PATH=/var/lib/faultline-runner/executions
RUNNER_CAPABILITY_PROGRAM_PATH=/app/dist/runner/capability-program.mjs
RUNNER_PROGRAM_PATH=/app/dist/runner/external-program.mjs

# Exact capability-probe scope.
RUNNER_PROVIDER_SCOPE=
RUNNER_PROBE_ORIGIN=
RUNNER_PRIVATE_PROBE_HOST=faultline-app.internal

# Provider-neutral hardened sandbox service.
RUNNER_PROVIDER=remote
REMOTE_SANDBOX_ENDPOINT=
REMOTE_SANDBOX_AUTH_KEY_B64=
REMOTE_SANDBOX_PROVIDER_ID=
REMOTE_SANDBOX_PROVIDER_VERSION=
REMOTE_SANDBOX_ISOLATION_CONFIGURATION_HASH=
REMOTE_SANDBOX_REQUEST_TIMEOUT_MS=630000
