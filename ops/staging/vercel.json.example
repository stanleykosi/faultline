{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm contracts:generate && pnpm build:web",
  "outputDirectory": "dist/web",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://faultline-api.replace-with-approved-host.invalid/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://faultline-api.replace-with-approved-host.invalid/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
