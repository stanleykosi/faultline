{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "dist/server",
    "rootDir": ".",
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "apps/api/src/**/*.ts",
    "apps/worker/src/**/*.ts",
    "packages/**/*.ts",
    "tools/ops/**/*.ts",
    "tests/integration/**/*.ts",
    "apps/runner/src/**/*.ts",
    "tests/acceptance/**/*.ts"
  ]
}
