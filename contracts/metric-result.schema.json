                            "low": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "high": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "level": {
                              "const": 0.95
                            },
                            "method": {
                              "const": "wilson_descriptive"
                            }
                          },
                          "required": [
                            "low",
                            "high",
                            "level",
                            "method"
                          ]
                        },
                        {
                          "type": "null"
