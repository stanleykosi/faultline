# Copy privately to .env.ops. The API and worker must never load this file.
MIGRATION_DATABASE_URL=postgresql://faultline_operator:REPLACE_RANDOM_PASSWORD@127.0.0.1:5432/faultline
API_DATABASE_PASSWORD=REPLACE_AT_LEAST_24_RANDOM_CHARACTERS
AUTH_DATABASE_PASSWORD=REPLACE_DIFFERENT_24_RANDOM_CHARACTERS
QUEUE_DATABASE_PASSWORD=REPLACE_DIFFERENT_24_RANDOM_CHARACTERS
DISPATCHER_DATABASE_PASSWORD=REPLACE_DIFFERENT_24_RANDOM_CHARACTERS
BOOTSTRAP_EMAIL=owner@example.invalid
BOOTSTRAP_PASSWORD=REPLACE_PRIVATE_PASSWORD
APP_ORIGIN=http://localhost:3000
AUTH_SECRET=REPLACE_MATCHING_RUNTIME_AUTH_SECRET
# pg_dump and psql PostgreSQL17 client directory for offline recovery:
PG_BIN_DIRECTORY=REPLACE_WITH_ABSOLUTE_CLIENT_BIN_DIRECTORY
# Configure RECOVERY_EMAIL and RECOVERY_PASSWORD privately only for an authorized account recovery.
