{
  "name": "faultline",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Evidence-bound conversion regression investigations",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "fixture:serve": "node fixtures/checkout-site/server.mjs",
    "contracts:generate": "node scripts/generate-contracts.mjs && node scripts/generate-runtime-migrations.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/typescript/bin/tsc -p apps/web/tsconfig.json",
    "typecheck:web": "node node_modules/typescript/bin/tsc -p apps/web/tsconfig.json",
    "build": "pnpm contracts:generate && node node_modules/typescript/bin/tsc && pnpm build:runner-program && pnpm build:web",
    "build:runner-program": "node scripts/build-runner-program.mjs",
    "build:web": "node node_modules/vite/bin/vite.js build apps/web --configLoader runner",
    "dev": "node scripts/dev.mjs",
    "hosting:context": "node scripts/package-hosted-context.mjs",
    "hosting:vercel:prepare": "node scripts/prepare-vercel-supabase.mjs",
    "db:migrate:supabase": "node --import tsx --env-file-if-exists=.env.supabase.ops tools/ops/migrate-supabase.ts",
    "test:hosting": "node --import tsx --test packages/core/src/storage/supabase-objects.test.ts packages/core/src/captures/direct-uploads.test.ts packages/database/src/identity-schema.test.ts apps/api/src/vercel-handler.test.ts scripts/initialize-vercel-runtime.test.mjs scripts/prepare-vercel-supabase.test.mjs",
    "start": "node --max-old-space-size=128 --env-file-if-exists=.env.local dist/server/apps/api/src/main.js",
    "worker": "node --max-old-space-size=128 --env-file-if-exists=.env.local scripts/start-worker.mjs",
    "db:migrate": "node --import tsx --env-file-if-exists=.env.ops tools/ops/migrate.ts",
    "bootstrap": "node --import tsx --env-file-if-exists=.env.ops tools/ops/bootstrap.ts",
    "test": "pnpm test:components && pnpm test:web && pnpm test:ops",
    "test:integration": "node --import tsx --env-file-if-exists=.env.local --env-file-if-exists=.env.ops --test tests/integration/*.test.ts",
    "db:roles": "node --import tsx --env-file-if-exists=.env.ops tools/ops/roles.ts",
    "db:local": "node tools/ops/local-database.mjs",
    "keys:init": "node --import tsx tools/ops/keyring.ts",
    "keys:maintenance": "node --import tsx tools/ops/key-maintenance.ts",
    "recover": "node --import tsx --env-file-if-exists=.env.ops tools/ops/recovery.ts",
    "doctor": "node --import tsx --env-file-if-exists=.env.local --env-file-if-exists=.env.ops tools/ops/doctor.ts",
    "backup": "node --import tsx --env-file-if-exists=.env.local --env-file-if-exists=.env.ops tools/ops/backup.ts",
    "restore": "node --import tsx --env-file-if-exists=.env.local --env-file-if-exists=.env.ops tools/ops/restore.ts",
    "test:components": "node --import tsx --test packages/core/src/**/*.test.ts packages/contracts/src/*.test.ts tests/integration/foundation-without-database.test.ts",
    "test:web": "node scripts/test-web.mjs",
    "test:ops": "node --import tsx --test tests/integration/backup-parts.test.ts tests/integration/backup-sql.test.ts tests/integration/backup-envelope.test.ts tests/integration/restore-database-config.test.ts tests/integration/recovery-capacity.test.ts tests/integration/export-diagnostics.test.ts tests/release-integrity.test.mjs packages/database/src/warm-pool.test.ts tools/ops/key-maintenance.test.ts tools/ops/key-maintenance-checkpoint.test.ts",
    "deploy:vercel": "node scripts/deploy-vercel.mjs"
  },
  "packageManager": "pnpm@9.15.1",
  "dependencies": {
    "@fastify/multipart": "9.2.1",
    "@fastify/static": "8.3.0",
    "@vercel/functions": "3.10.2",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "better-auth": "1.7.7",
    "csv-parse": "6.1.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "pg": "8.16.3",
    "pg-boss": "12.37.1",
    "railway": "3.16.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "embedded-postgres": "17.10.0-beta.17",
    "esbuild": "0.25.12",
    "json-schema-to-typescript": "15.0.4",
    "playwright": "1.56.1",
    "supabase": "2.121.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.9"
  }
}
