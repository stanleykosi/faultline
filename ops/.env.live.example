# Optional, explicitly authorized live checks. Values come from a secret store
# or local environment and must never enter fixtures, reports or source control.
# Missing values mean not configured/not_run, never a fabricated pass.

# Read existing completed PostHog file-download exports only.
FAULTLINE_LIVE_POSTHOG_HOST=
FAULTLINE_LIVE_POSTHOG_PROJECT_ID=
FAULTLINE_LIVE_POSTHOG_TOKEN=
FAULTLINE_LIVE_POSTHOG_EXPORT_RUN_IDS=
FAULTLINE_LIVE_POSTHOG_AUTHORIZATION_RECORD=

# Read-only selected repository metadata; no commits/comments/PR creation.
FAULTLINE_LIVE_GITHUB_REPOSITORY=
FAULTLINE_LIVE_GITHUB_TOKEN=
FAULTLINE_LIVE_GITHUB_AUTHORIZATION_RECORD=

# Optional capability-probed model profile and capped structured-output check.
FAULTLINE_LIVE_MODEL_PROFILE=

# Authorized disposable/staging targets and approved immutable manifests.
FAULTLINE_LIVE_RUNNER_PROFILE=
FAULTLINE_LIVE_ORIGIN_GRANT_ID=
FAULTLINE_LIVE_TEST_PLAN_ID=
FAULTLINE_LIVE_BUILD_ATTESTATIONS_PATH=
FAULTLINE_LIVE_RUNNER_AUTHORIZATION_RECORD=
