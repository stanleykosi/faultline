# Local operator only. Save filled values in ignored .env.supabase.ops.
# Never upload this file with values to Vercel, its Daemon, or a build context.
NODE_ENV=development
AUTH_DATABASE_SCHEMA=faultline_identity
APP_ORIGIN=https://faultline.example
AUTH_SECRET=SAME_PRIVATE_AUTH_SECRET_AS_RUNTIME
MIGRATION_DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=verify-full
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_STORAGE_SERVICE_KEY=SERVER_ONLY_SERVICE_KEY

# Fresh installation creates these roles only; upgrade does not change their passwords.
API_DATABASE_PASSWORD=NEW_RANDOM_24_PLUS_CHARACTER_PASSWORD
AUTH_DATABASE_PASSWORD=NEW_RANDOM_24_PLUS_CHARACTER_PASSWORD
QUEUE_DATABASE_PASSWORD=NEW_RANDOM_24_PLUS_CHARACTER_PASSWORD
DISPATCHER_DATABASE_PASSWORD=NEW_RANDOM_24_PLUS_CHARACTER_PASSWORD

# One-use protected installer enrollment, after migration and before public signup.
BOOTSTRAP_EMAIL=YOUR_EMAIL
BOOTSTRAP_PASSWORD=PRIVATE_12_PLUS_CHARACTER_PASSWORD
BOOTSTRAP_NAME=YOUR_NAME
BOOTSTRAP_WORKSPACE=YOUR_WORKSPACE
BOOTSTRAP_TOKEN_PATH=.runtime/supabase-bootstrap-token
