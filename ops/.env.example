# Reference environment names for the application to implement.
# Empty secrets are intentional. Generate private values during setup.
# Never commit a filled .env, keyring, certificate or browser storage state.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
PUBLIC_SIGNUP_ENABLED=false

# Same PostgreSQL installation, distinct reviewed database roles/pools.
DATABASE_URL=
AUTH_DATABASE_URL=
QUEUE_DATABASE_URL=
MIGRATION_DATABASE_URL=
AUTH_SECRET=

# Private local storage is the default. It must be outside the web root.
OBJECT_STORE=filesystem
OBJECT_STORE_PATH=
SECRET_KEYRING_PATH=
REPORT_SIGNING_KEY_PATH=

# Optional object-store implementation; inactive unless implemented/configured.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=

# Manual/deterministic mode requires no model or paid API.
MODEL_PROVIDER=none
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_ID=

# Explicit local fixture mode is separate from a production remote runner.
RUNNER_MODE=disabled
RUNNER_URL=
RUNNER_CA_PATH=
RUNNER_CLIENT_CERT_PATH=
RUNNER_CLIENT_KEY_PATH=
ALLOW_FIXTURE_ADAPTERS=true

# Default invitations are manually copied one-use links; no outbound email.
ENABLE_EMAIL_DELIVERY=false
