# Credentials and installation-specific settings only; keep filled files private.
# Copy each section to its indicated destination, not the whole file to runtime.

# Runtime: .env.local or API/worker hosting secrets.
APP_ORIGIN=
AUTH_SECRET=
DATABASE_URL=
AUTH_DATABASE_URL=
QUEUE_DATABASE_URL=
DISPATCHER_DATABASE_URL=
# AUTH_SECRET: at least 32 random characters. Use distinct restricted database roles.

# Server-managed AI providers: configure the profiles used by investigations.
# OpenRouter: use the exact provider/model ID.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_WORKSPACE_ID=
# Nightshift: use its real runtime proxy token, not an upstream NVIDIA key.
METERLESS_RUNTIME_TOKEN=
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_MODEL=meterless/auto
METERLESS_WORKSPACE_ID=
# Blank workspace IDs make server profiles available across workspaces.
# Add the exact reachable HTTPS Nightshift origin for hosted installations.
MODEL_ALLOWED_ORIGINS=["https://openrouter.ai"]
# Local Nightshift: set this to ["http://127.0.0.1:8088"] explicitly.
# Hosted API/worker services cannot reach Nightshift on your laptop loopback.
MODEL_LOCAL_ORIGINS=[]

# Zetaris runtime: use the same reviewed bindings in the API and worker.
# Add the actual instance HTTPS origin to this JSON allowlist.
CONNECTOR_ALLOWED_ORIGINS=[]
# Replace [] with the binding array below, using your actual instance values.
ZETARIS_REST_ADAPTERS=[]
# Binding example (organisation_id is a positive integer):
# [{"adapter_id":"zetaris-rest-v1","approved_origin":"https://YOUR_ZETARIS_HOST","contract_hash":"YOUR_REVIEWED_64_CHARACTER_SHA256","organisation_id":123}]
# Enter the Zetaris API key and approved view mappings in workspace Sources.
# The source account scope is zetaris:org:<your organisation_id>.
# Setup and migration requirements: config/provider-setup.md.

# Supabase hosting only. Use the server-side Storage service key.
# Profile settings: OBJECT_STORE=supabase and AUTH_DATABASE_SCHEMA=faultline_identity.
SUPABASE_URL=
SUPABASE_STORAGE_SERVICE_KEY=
# Stable encryption/signing material shared by the API and worker; preserve on redeploy.
FAULTLINE_SEALED_SECRET_KEYRING_JSON_B64=
FAULTLINE_SEALED_REPORT_SIGNING_PRIVATE_PEM_B64=
FAULTLINE_SEALED_REPORT_SIGNING_PUBLIC_PEM_B64=

# Operator only: .env.ops; never put these in API/worker hosting secrets.
MIGRATION_DATABASE_URL=
API_DATABASE_PASSWORD=
AUTH_DATABASE_PASSWORD=
QUEUE_DATABASE_PASSWORD=
DISPATCHER_DATABASE_PASSWORD=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
# Role passwords: 24+ random characters each. Initial owner password: 12+ characters.
# Optional encrypted backup: private path to the independently retained wrapping key.
BACKUP_WRAP_KEY_PATH=

# Deployment CLI environment: your explicitly selected Vercel target.
FAULTLINE_VERCEL_PROJECT_ID=
FAULTLINE_VERCEL_TEAM_ID=
FAULTLINE_VERCEL_ORIGIN=

# Separate hardened runner only; omit when external browser execution is unused.
EXTERNAL_RUNNER_AUTH_KEY_B64=
REMOTE_SANDBOX_ENDPOINT=
REMOTE_SANDBOX_AUTH_KEY_B64=

# Workspace Sources worksheet: enter these in the app, not the runtime environment.
# These commented names are setup labels, not automatically loaded env variables.
# POSTHOG_APP_HOST=
# POSTHOG_PROJECT_ID=
# POSTHOG_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPOSITORY=
# GITHUB_TOKEN=

